<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RemoteAgent.Updater</RootNamespace>
    <AssemblyName>RemoteAgent.Updater</AssemblyName>
    <OutputType>Exe</OutputType>
    <Version>2.2.7.1</Version>
    <ApplicationIcon>..\..\icon\app.ico</ApplicationIcon>

    <!-- Small standalone executable that replaces the main agent, so it cannot be the same exe. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteAgent.Contracts\RemoteAgent.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the agent: both SYSTEM services secure the ProgramData folder they work in. -->
    <Compile Include="..\RemoteAgent\Security\DataDirectorySecurity.cs" Link="Security\DataDirectorySecurity.cs" />
    <!-- Shared with the consoles: the status pipe's other end must be the agent service before its answer counts. -->
    <Compile Include="..\RemoteClient.Core\PipePeer.cs" Link="Ipc\PipePeer.cs" />
  </ItemGroup>

</Project>
